{
  "name": "io.github.acme/files",
  "description": "A slot the document itself calls secret, arriving filled in.",
  "version": "2.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@acme/mcp-files",
      "version": "2.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SESSION",
          "isSecret": true,
          "value": "changeme"
        }
      ]
    }
  ]
}
