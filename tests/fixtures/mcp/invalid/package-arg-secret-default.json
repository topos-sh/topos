{
  "name": "io.github.acme/files",
  "description": "A flag named for a credential, carrying it as a default.",
  "version": "2.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@acme/mcp-files",
      "version": "2.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--api-key",
          "default": "acme-house-key"
        }
      ]
    }
  ]
}
