{
  "name": "io.github.acme/issues",
  "description": "A package carrying somebody's credential in an environment slot.",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@acme/mcp-issues",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GITHUB_TOKEN",
          "value": "changeme"
        }
      ]
    }
  ]
}
