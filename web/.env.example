# The web app's DEV environment (see app/env.server.ts — the schema, parsed lazily, never at build).
# There is deliberately NO client-side env: the app ships zero VITE_-prefixed values.
#
# Self-hosting rather than hacking on the app? This is the wrong file: the deployment's whole config
# surface is the repo root's `.env.example`, beside `docker-compose.yml`.

# The web role's connection (owns schema `web`; broad SELECT on the vault's schema `plane`).
DATABASE_URL=postgresql://topos_web:web@localhost:5439/topos_dev

# Better Auth: the session secret (>= 32 chars) and this app's own origin.
BETTER_AUTH_SECRET=dev-only-secret-not-for-any-deployment
BETTER_AUTH_URL=http://localhost:3000

# The vault, over the internal network, and the shared bearer for its internal session lane (the
# vault answers the whole lane with 404 until its side sets the same token). Never a public URL.
PLANE_INTERNAL_URL=http://localhost:8790
PLANE_INTERNAL_TOKEN=dev-internal-token

# development relaxes exactly one thing: the boot refusal on the values this project once shipped as
# compose defaults. Everything else behaves as in production.
APP_ENV=development
