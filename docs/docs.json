{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Topos",
  "description": "Topos is the layer AI agents use to share behaviors across a team — publish once, every teammate's agent stays current, and improvements flow back.",
  "colors": {
    "primary": "#002fa7",
    "light": "#6691ff",
    "dark": "#00227a"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://topos.sh"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Martian Mono"
    },
    "body": {
      "family": "IBM Plex Sans"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/topos-sh/topos"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Topos",
      "href": "https://topos.sh"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "install",
              "for-agents"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/overview",
              "concepts/skills",
              "concepts/manifests",
              "concepts/references",
              "concepts/workspaces-and-sessions",
              "concepts/channels",
              "concepts/versions-and-governance"
            ]
          },
          {
            "group": "Motions",
            "pages": [
              "motions/connect-a-machine",
              "motions/receive-skills",
              "motions/publish-a-skill",
              "motions/propose-and-review",
              "motions/curate-channels",
              "motions/import-from-github",
              "motions/roll-back",
              "motions/grow-the-team",
              "motions/stop-receiving"
            ]
          },
          {
            "group": "Agent harnesses",
            "pages": [
              "harnesses/how-it-works",
              "harnesses/supported"
            ]
          }
        ]
      },
      {
        "tab": "Self-hosting",
        "icon": "server",
        "groups": [
          {
            "group": "Run your own",
            "pages": [
              "self-hosting/overview",
              "self-hosting/deploy",
              "self-hosting/first-run",
              "self-hosting/configuration",
              "self-hosting/mail",
              "self-hosting/tls-and-proxy",
              "self-hosting/external-postgres",
              "self-hosting/backups",
              "self-hosting/upgrades",
              "self-hosting/operations"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "terminal",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/cli",
              "reference/topos-toml",
              "reference/json-envelope",
              "reference/security",
              "reference/glossary",
              "reference/troubleshooting"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/topos-sh/topos"
        },
        {
          "anchor": "Releases",
          "icon": "tag",
          "href": "https://github.com/topos-sh/topos/releases"
        }
      ]
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/topos-sh/topos",
      "website": "https://topos.sh"
    },
    "links": [
      {
        "header": "Project",
        "items": [
          {
            "label": "Source (Apache-2.0)",
            "href": "https://github.com/topos-sh/topos"
          },
          {
            "label": "Architecture",
            "href": "https://github.com/topos-sh/topos/blob/main/ARCHITECTURE.md"
          },
          {
            "label": "Security policy",
            "href": "https://github.com/topos-sh/topos/blob/main/SECURITY.md"
          },
          {
            "label": "Contributing",
            "href": "https://github.com/topos-sh/topos/blob/main/CONTRIBUTING.md"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search the Topos docs"
  }
}
